# Copy to .env and chmod 600 .env. Never commit credentials.
COMPOSE_PROJECT_NAME=protonnode
EXIT_HOSTNAME=protonnode
CONTROL_HOSTNAME=proton-control
# Optional comma-separated Tailscale login emails allowed to use the dashboard.
# Empty = the management node's owner. Set explicitly for a tagged node.
# Set to * to allow every Tailscale-verified device, including tagged devices;
# use Tailscale ACLs/grants to restrict access to the panel.
# API-key access remains available to automation.
CONTROLLER_ALLOWED_LOGINS=

# Dedicated internal Docker link. Change all three together if the subnet is in use.
VPN_TRANSIT_SUBNET=172.30.222.0/29
VPN_GATEWAY_IP=172.30.222.2
EXIT_TRANSIT_IP=172.30.222.3

# Two non-ephemeral, preauthorized Tailscale auth keys, one for each new identity.
TS_EXIT_AUTHKEY=replace-with-exit-node-auth-key
TS_CONTROL_AUTHKEY=replace-with-control-node-auth-key
# Allows time to complete browser login when auth keys are left empty.
TS_BOOT_TIMEOUT=30m

# PrivateKey from a Proton-generated WireGuard configuration (NOT your password).
WIREGUARD_PRIVATE_KEY=replace-with-proton-wireguard-private-key
# Copy Address and DNS from the same Proton config if different from these defaults.
WIREGUARD_ADDRESSES=10.2.0.2/32
# Proton path MTU. Tailscale transport now uses a separate network path.
WIREGUARD_MTU=1400
PROTON_DNS_ADDRESS=10.2.0.1
# If DNS differs, also update config/exit-resolv.conf.

# Initial selection. A verified dashboard/API selection overrides this on restart.
SERVER_COUNTRIES=Netherlands
SERVER_CITIES=
SERVER_HOSTNAMES=
PORT_FORWARD_ONLY=on
TOR_ONLY=off

# Intentionally disabled: P2P outbound works without an inbound forwarded port.
VPN_PORT_FORWARDING=off
